# Copy to .env and change the passwords: cp .env.example .env
# MongoDB auth
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=devboard

# Backend
MONGO_URI=mongodb://admin:change-me@mongodb:27017/devboard?authSource=admin
PORT=5000
NODE_ENV=production

# Frontend
REACT_APP_API_URL=/api
